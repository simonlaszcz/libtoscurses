#
# Termcap entries for Atari STs' built in VT52 emulation.
#
s0|st52|Atari ST:\
	:al=\EL:am:bl=^G:bs:cd=\EJ:ce=\EK:cl=\EE:cm=\EY%+ %+ :co#80:dl=\EM:\
	:do=^J:eo:ho=\EH:is=\Eq\EE\Ee\Ev:it#8:le=^H:li#25:ll=\EY9!:\
	:me=\Eq:mr=\Ep:nd=\EC:rc=\Ek:sc=\Ej:se=\Eq:so=\Ep:ta=^I:\
	:ti=\Eq\Ev\Ee:up=\EA:ve=\Ee:vi=\Ef:
#
# Atari ST with Hi50 hack
s1|st52l|Atari ST, 50 line screen:\
	:al=\EL:am:bl=^G:bs:cd=\EJ:ce=\EK:cl=\EE:cm=\EY%+!%+!:co#80:dl=\EM:\
	:do=^J:eo:ho=\EH:is=\Eq\EE\Ee\Ev:it#8:le=^H:li#50:ll=\EY9!:\
	:me=\Eq:mr=\Ep:nd=\EC:rc=\Ek:sc=\Ej:se=\Eq:so=\Ep:ta=^I:\
	:ti=\Eq\Ev\Ee:up=\EA:ve=\Ee:vi=\Ef:
#
# Termcap entry contributed by Lars Bo Nielsen (lbn@iesd.auc.dk)
#	Thanks!
#
#atari|vt52|AtariST:\
# (Meta key) (Auto margin (see :ti=)) (cols) (rows) (bell) (CR)
#	:km:am:co#80:li#25:bl=^G:cr=^M:\
# Position cursor (x, y)
#	:cm=\EY%+ %+ :\
# Cursor movement (Down) (Up) (Left) (Right)
#	:do=\EB:up=\EA:le=\ED:nd=\EC:\
# Home cursor (clear screen) (don't clear screen)
#	:cl=\EE:ho=\EH:\
# Send by BS key
#	:kb=^H:\
# Save and restore cursor position
#	:sc=\Ej:rc=\Ek:\
# Cursor appearance (normal) (invisible)
#	:ve=\Ee:vi=\Ef:\
# Stand out mode (reverse video on) (reverse video off)
#	:so=\Ep:se=\Eq:\
# Lines (Add line) (Clear to EOL) (Delete line)
#	:al=\EL:ce=\EK:dl=\EM:\
# Clear to end of display
#	:cd=\EJ:\
# Terminal initialization (auto-wrap since :am: set, cursor on)
#	:ti=\Ev\Ee:\
# Scroll text down
#        :sr=\EI:\
# Hardware tabs (send CTRL I) (8 space/tab) (has hardware tabs)
#	:ta=^I:it#8:pt:
#
# ATARI ST termcap entry (without comments)
atari|vt52|AtariST:\
	:km:am:co#80:li#25:bl=^G:cr=^M:\
	:cm=\EY%+ %+ :\
	:do=\EB:up=\EA:le=\ED:nd=\EC:\
	:cl=\EE:ho=\EH:\
	:kb=^H:\
	:sc=\Ej:rc=\Ek:\
	:ve=\Ee:vi=\Ef:\
	:so=\Ep:se=\Eq:\
	:al=\EL:ce=\EK:dl=\EM:\
	:cd=\EJ:\
	:ti=\Ev\Ee:\
        :sr=\EI:\
	:ta=^I:it#8:pt:
